# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = tab
trim_trailing_whitespace = true
insert_final_newline = true

[{*.yml,*.yaml,package.json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

[*.json]
indent_style = space
indent_size = 4
